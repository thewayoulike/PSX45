{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/pypsx.py": {
      "maxDuration": 45,
      "memory": 1024,
      "includeFiles": "lib/market/*.py",
      "excludeFiles": "{node_modules,dist,src,public,.cursor,.github,.git,data,coverage,tests,canvases}/**"
    },
    "api/run-alerts.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/request-access",
      "destination": "/api/notify-signup"
    },
    {
      "source": "/login/:path*",
      "destination": "/index"
    },
    {
      "source": "/reset-password/:path*",
      "destination": "/index"
    },
    {
      "source": "/suggestions/:path*",
      "destination": "/index"
    },
    {
      "source": "/settings/:path*",
      "destination": "/index"
    },
    {
      "source": "/holdings/:path*",
      "destination": "/index"
    },
    {
      "source": "/stocks/:path*",
      "destination": "/index"
    },
    {
      "source": "/stock/:path*",
      "destination": "/index"
    },
    {
      "source": "/fund/:path*",
      "destination": "/index"
    },
    {
      "source": "/sector/:path*",
      "destination": "/index"
    },
    {
      "source": "/realized/:path*",
      "destination": "/index"
    },
    {
      "source": "/history/:path*",
      "destination": "/index"
    },
    {
      "source": "/watchlist/:path*",
      "destination": "/index"
    },
    {
      "source": "/signals/:path*",
      "destination": "/index"
    },
    {
      "source": "/alerts/:path*",
      "destination": "/index"
    },
    {
      "source": "/assistant/:path*",
      "destination": "/index"
    },
    {
      "source": "/simulator/:path*",
      "destination": "/index"
    },
    {
      "source": "/calculator/:path*",
      "destination": "/index"
    },
    {
      "source": "/charts/:path*",
      "destination": "/index"
    },
    {
      "source": "/backtest/:path*",
      "destination": "/index"
    },
    {
      "source": "/daily-scan/:path*",
      "destination": "/index"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/index"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(login|reset-password|suggestions|settings|holdings|stocks|stock|fund|sector|realized|history|watchlist|signals|alerts|assistant|simulator|calculator|charts|backtest|daily-scan|dashboard|admin)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests; worker-src 'self'; manifest-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://accounts.google.com https://apis.google.com https://www.gstatic.com https://www.googletagmanager.com https://s3.tradingview.com https://*.tradingview.com; frame-src https://accounts.google.com https://content.googleapis.com https://docs.google.com https://drive.google.com https://*.tradingview.com; connect-src 'self' https://*.supabase.co https://accounts.google.com https://oauth2.googleapis.com https://apis.google.com https://www.googleapis.com https://sheets.googleapis.com https://gmail.googleapis.com https://script.google.com https://script.googleusercontent.com https://content.googleapis.com https://generativelanguage.googleapis.com https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://www.googletagmanager.com https://dps.psx.com.pk https://www.mufap.com.pk https://mufap.com.pk https://docs.google.com https://api.allorigins.win https://api.codetabs.com https://corsproxy.io https://thingproxy.freeboard.io https://r.jina.ai https://api.scrape.do https://api.ocr.space https://api.webscraping.ai https://webscraping.ai https://dashboard.scrape.do https://open.er-api.com https://www.svgrepo.com https://fonts.googleapis.com"
        }
      ]
    }
  ]
}
